<Window x:Class="PatchAdamsSharp.PatchAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign patch labels" Width="620" Height="440" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OneDarkSurface}" Foreground="{StaticResource OneDarkText}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Margin="0,0,0,10"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True"/>
                <Button x:Name="LoadButton" Content="Load patches" IsDefault="True"
                        IsEnabled="False" Click="Load_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Which candidate is each patch?" FontWeight="SemiBold"/>
            <TextBlock Text="The filenames do not identify every patch unambiguously. Assign each file a different label from A to D. These are the original candidate labels, before any blind-mode shuffle."
                       TextWrapping="Wrap" Margin="0,6,0,14"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="AssignmentRows"/>
        </ScrollViewer>
    </DockPanel>
</Window>
