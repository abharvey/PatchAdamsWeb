<Window x:Class="PatchAdamsSharp.ReviewerFeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reviewer feedback" Width="760" Height="560" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{StaticResource OneDarkSurface}" Foreground="{StaticResource OneDarkText}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Paste Slack messages or other reviewer feedback here. This does not change findings automatically."
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Label Grid.Row="1" Content="Reviewer feedback" Target="{Binding ElementName=FeedbackBox}"/>
        <TextBox x:Name="FeedbackBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Reviewer feedback"/>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True"/>
                <Button Content="Keep feedback" Click="Keep_Click"/>
            </StackPanel>
            <TextBlock Text="Kept in session saves and JSON exports, not Markdown. Save the session to persist changes."
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
