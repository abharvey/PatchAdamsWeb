<Window x:Class="PatchAdamsSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchAdams#" Width="1400" Height="900" MinWidth="720" MinHeight="500"
        Background="{StaticResource OneDarkWindow}" Foreground="{StaticResource OneDarkText}" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="MainWindow_DragOver" Drop="MainWindow_Drop">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource OneDarkWindow}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="PatchAdams#" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,16,0"/>
                <Menu DockPanel.Dock="Left" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New session…" Click="NewSession_Click"/>
                        <Separator/>
                        <MenuItem Header="Choose _base…" Click="ChooseBase_Click"/>
                        <MenuItem Header="Choose _archive…" Click="ChooseArchive_Click"/>
                        <MenuItem Header="_Git revision…" Click="ChooseGitRevision_Click"/>
                        <MenuItem Header="Rebuild base from patches" Click="RebuildSyntheticBase_Click"/>
                        <Separator/>
                        <MenuItem Header="Add _patches…" Click="AddPatches_Click"/>
                        <MenuItem Header="Paste patch" Click="PastePatch_Click" InputGestureText="Ctrl+Alt+V"/>
                        <Separator/>
                        <MenuItem Header="_Open session…" Click="OpenSession_Click"/>
                        <MenuItem Header="_Save session…" Click="SaveSession_Click" InputGestureText="Ctrl+S"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Manage columns…" Click="ManageColumns_Click"/>
                        <MenuItem x:Name="BalanceWidthsButton" Header="_Balance widths" IsEnabled="False"
                                  Click="BalanceWidths_Click" ToolTip="Fit expanded patch columns to the available space"/>
                        <Separator/>
                        <MenuItem x:Name="RequestPanelToggle" Header="_Request panel" IsCheckable="True"
                                  IsChecked="True" Click="RequestPanelToggle_Click"/>
                        <MenuItem x:Name="ScrollLockToggle" Header="_Scroll lock" IsCheckable="True"
                                  InputGestureText="Ctrl+L"/>
                        <MenuItem x:Name="ShowRemovedToggle" Header="Removed _lines" IsCheckable="True"
                                  IsChecked="True" Checked="ShowRemoved_Changed" Unchecked="ShowRemoved_Changed"/>
                        <Separator/>
                        <MenuItem Header="Smaller code font" Click="SmallerFont_Click"/>
                        <MenuItem Header="Larger code font" Click="LargerFont_Click"/>
                        <MenuItem Header="_Theme">
                            <MenuItem x:Name="AyuDarkTheme" Header="_Ayu Dark" IsCheckable="True" Click="Theme_Click"/>
                            <MenuItem x:Name="OneDarkTheme" Header="_One Dark" IsCheckable="True" Click="Theme_Click"/>
                        </MenuItem>
                        <MenuItem Header="Se_ttings…" Click="Settings_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Review">
                        <MenuItem x:Name="GoldenMenu" Header="_Golden patch"/>
                        <MenuItem x:Name="BlindModeToggle" Header="_Blind review" IsCheckable="True"
                                  Checked="BlindMode_Changed" Unchecked="BlindMode_Changed"/>
                        <Separator/>
                        <MenuItem Header="_Copy reference" Click="CopyReference_Click" InputGestureText="Ctrl+Shift+C"/>
                    </MenuItem>
                    <MenuItem Header="_Export">
                        <MenuItem Header="_Markdown…" Click="ExportMarkdown_Click" InputGestureText="Ctrl+E"/>
                        <MenuItem Header="_JSON…" Click="ExportJson_Click" InputGestureText="Ctrl+Shift+E"/>
                        <MenuItem Header="_Copy Markdown" Click="CopyMarkdown_Click" InputGestureText="Ctrl+Alt+E"/>
                    </MenuItem>
                </Menu>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                    <Label Content="_Search:" Target="{Binding ElementName=SearchBox}"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Width="220" Margin="4,0,6,0"
                             VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                    <Button Content="Find" Click="Search_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="RequestPanel" DockPanel.Dock="Top" Background="{StaticResource OneDarkSurface}" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="▲" FontSize="10" Width="28" Padding="0"
                        VerticalAlignment="Top" ToolTip="Hide request panel (restore from View)"
                        Click="CollapseRequestPanel_Click"/>
                <Label DockPanel.Dock="Left" Content="Request:" Target="{Binding ElementName=RequestBox}"/>
                <TextBox x:Name="RequestBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                         VerticalScrollBarVisibility="Auto" Background="{StaticResource OneDarkWindow}" Foreground="{StaticResource OneDarkText}"
                         BorderBrush="{StaticResource OneDarkControlBorder}" ToolTip="Paste the task request being reviewed"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilePanelColumn" Width="230"/>
                <ColumnDefinition x:Name="FilePanelSplitterColumn" Width="6"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition x:Name="ReviewPanelSplitterColumn" Width="6"/>
                <ColumnDefinition x:Name="ReviewPanelColumn" Width="270"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource OneDarkBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <DockPanel x:Name="FilePanelContents" Margin="6">
                        <DockPanel DockPanel.Dock="Top" Margin="6">
                            <Button DockPanel.Dock="Right" Content="◀" FontSize="10" Width="28"
                                    Padding="0" ToolTip="Collapse Files" Click="CollapseFilePanel_Click"/>
                            <TextBlock DockPanel.Dock="Left" Text="Files" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="TestsOnlyToggle" Content="Tests only" Margin="12,0,0,0"
                                      VerticalAlignment="Center" Checked="TestsOnly_Changed" Unchecked="TestsOnly_Changed"/>
                        </DockPanel>
                        <TreeView x:Name="FileTree" SelectedItemChanged="FileTree_SelectedItemChanged"
                                  Background="{StaticResource OneDarkWindow}" Foreground="{StaticResource OneDarkText}" BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="2"/>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                    <Button x:Name="FilePanelTab" Visibility="Collapsed" Click="ExpandFilePanel_Click"
                            Margin="3" Padding="0" ToolTip="Expand Files">
                        <TextBlock Text="Files" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>
            <GridSplitter x:Name="FilePanelSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Cursor="SizeWE" Background="{StaticResource OneDarkControlBorder}"
                          DragCompleted="SidePanelSplitter_DragCompleted"/>
            <DockPanel x:Name="CodeWorkspace" Grid.Column="2" Margin="4">
                <TextBlock x:Name="SelectedFileText" DockPanel.Dock="Top" Visibility="Collapsed"
                           FontSize="12" Foreground="{StaticResource OneDarkText}" Margin="4,0,4,3"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Grid x:Name="ColumnsGrid"/>
            </DockPanel>
            <GridSplitter x:Name="ReviewPanelSplitter" Grid.Column="3" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Cursor="SizeWE" Background="{StaticResource OneDarkControlBorder}"
                          DragCompleted="SidePanelSplitter_DragCompleted"/>
            <Border Grid.Column="4" Background="{StaticResource OneDarkSurface}" BorderBrush="{StaticResource OneDarkBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <DockPanel x:Name="ReviewPanelContents" Margin="10">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="▶" FontSize="10" Width="28"
                                    Padding="0" ToolTip="Collapse Review" Click="CollapseReviewPanel_Click"/>
                            <TextBlock Text="Review" FontSize="16" FontWeight="Bold"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Selection reference" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReferenceText" Text="Select lines in a column to generate a reference."
                                           TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <TextBlock Text="Ctrl+drag adds a range. Drag without Ctrl or press Esc to start over."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                                <TextBlock Text="Compare selected ranges" FontWeight="SemiBold"/>
                                <ListBox x:Name="ComparisonList" Height="150" Margin="0,4,0,10"
                                         DisplayMemberPath="DisplayText" SelectionChanged="ComparisonList_SelectionChanged"/>
                                <TextBlock Text="Findings" FontWeight="SemiBold"/>
                                <ListBox x:Name="FindingsList" Margin="0,4,0,8" Height="260"
                                         SelectionChanged="FindingsList_SelectionChanged"/>
                                <Button Content="Add finding from selection…" Click="AddFinding_Click"/>
                                <Button x:Name="RemoveFindingButton" Content="Remove selected finding…"
                                        IsEnabled="False" Click="RemoveFinding_Click"/>
                                <Button Content="Reviewer feedback…" Click="ReviewerFeedback_Click"
                                        ToolTip="Paste reviewer feedback and keep it with this session"/>
                                <Button Content="Pin selection" Click="PinSelection_Click"/>
                                <Button Content="Correct anchor from last two selections" Click="CorrectAnchor_Click"/>
                                <Button Content="Show raw patch…" Click="ShowRawPatch_Click"/>
                                <TextBlock Text="Pins" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ListBox x:Name="PinsList" Height="100" DisplayMemberPath="Reference"
                                         SelectionChanged="PinsList_SelectionChanged"/>
                                <TextBlock Text="Ranking (ties allowed)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <StackPanel x:Name="RankingPanel"/>
                                <TextBox x:Name="RationaleBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                         VerticalScrollBarVisibility="Auto" Margin="0,6,0,4"
                                         ToolTip="Ranking rationale"/>
                                <TextBlock Text="Apply report" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <TextBlock x:Name="ReportText" Text="Choose a base and add 2–4 patches."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    <Button x:Name="ReviewPanelTab" Visibility="Collapsed" Click="ExpandReviewPanel_Click"
                            Margin="3" Padding="0" ToolTip="Expand Review">
                        <TextBlock Text="Review" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource OneDarkWindow}" Padding="6">
            <TextBlock x:Name="StatusText" Text="Ready — nothing leaves this computer."/>
        </Border>
    </DockPanel>
</Window>
