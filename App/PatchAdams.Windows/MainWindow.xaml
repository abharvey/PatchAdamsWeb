<Window x:Class="PatchAdamsSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchAdams#" Width="1400" Height="900" MinWidth="1000" MinHeight="650"
        Background="#101A2B" Foreground="#E7EDF5" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="MainWindow_DragOver" Drop="MainWindow_Drop">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#18263B" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="PatchAdams#" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,16,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose base…" Click="ChooseBase_Click"/>
                    <Button Content="Choose archive…" Click="ChooseArchive_Click"/>
                    <Button Content="Git revision…" Click="ChooseGitRevision_Click"/>
                    <Button Content="Rebuild base from patches" Click="RebuildSyntheticBase_Click"/>
                    <Button Content="Add patches…" Click="AddPatches_Click"/>
                    <Button Content="Paste patch" Click="PastePatch_Click"/>
                    <Button Content="Open session…" Click="OpenSession_Click"/>
                    <Button Content="Save session…" Click="SaveSession_Click"/>
                    <Button Content="Manage columns…" Click="ManageColumns_Click"/>
                    <Button Content="Export Markdown…" Click="ExportMarkdown_Click"/>
                    <Button Content="Export JSON…" Click="ExportJson_Click"/>
                    <TextBlock Text="Golden:" VerticalAlignment="Center" Margin="14,0,2,0"/>
                    <ComboBox x:Name="GoldenPicker" Width="130" SelectionChanged="GoldenPicker_SelectionChanged"
                              VerticalContentAlignment="Center" Margin="4,0"/>
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="12,0,2,0"/>
                    <TextBox x:Name="SearchBox" Width="180" VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Content="Find" Click="Search_Click"/>
                    <Button Content="Copy reference" Click="CopyReference_Click"/>
                    <CheckBox x:Name="ScrollLockToggle" Content="Scroll lock" VerticalAlignment="Center"
                              Margin="8,0,4,0"/>
                    <Button Content="A−" Click="SmallerFont_Click"/>
                    <Button Content="A+" Click="LargerFont_Click"/>
                    <CheckBox x:Name="ShowRemovedToggle" Content="Removed" IsChecked="True"
                              VerticalAlignment="Center" Margin="6,0,4,0" Checked="ShowRemoved_Changed"
                              Unchecked="ShowRemoved_Changed"/>
                    <CheckBox x:Name="BlindModeToggle" Content="Blind review" VerticalAlignment="Center"
                              Margin="12,0,4,0" Checked="BlindMode_Changed" Unchecked="BlindMode_Changed"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#21334D" Padding="8">
            <TextBox x:Name="RequestBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                     VerticalScrollBarVisibility="Auto" Background="#17263B" Foreground="#E7EDF5"
                     BorderBrush="#415572" ToolTip="Paste the task request being reviewed"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#31445F" BorderThickness="0,0,1,0" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Files" FontWeight="Bold" Margin="6"/>
                    <TreeView x:Name="FileTree" SelectedItemChanged="FileTree_SelectedItemChanged"
                              Background="#101A2B" Foreground="#E7EDF5" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="2"/>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ColumnsGrid" Margin="6"/>
            </ScrollViewer>
            <Border Grid.Column="2" BorderBrush="#31445F" BorderThickness="1,0,0,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Review" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel>
                        <TextBlock Text="Selection reference" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReferenceText" Text="Select lines in a column to generate a reference."
                                   TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <TextBlock Text="Compare this region" FontWeight="SemiBold"/>
                        <ListBox x:Name="ComparisonList" Height="150" Margin="0,4,0,10"
                                 DisplayMemberPath="DisplayText" SelectionChanged="ComparisonList_SelectionChanged"/>
                        <TextBlock Text="Findings" FontWeight="SemiBold"/>
                        <ListBox x:Name="FindingsList" Margin="0,4,0,8" Height="260"
                                 SelectionChanged="FindingsList_SelectionChanged"/>
                        <Button Content="Add finding from selection…" Click="AddFinding_Click"/>
                        <Button Content="Pin selection" Click="PinSelection_Click"/>
                        <Button Content="Correct anchor from last two selections" Click="CorrectAnchor_Click"/>
                        <Button Content="Show raw patch…" Click="ShowRawPatch_Click"/>
                        <TextBlock Text="Pins" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <ListBox x:Name="PinsList" Height="100" DisplayMemberPath="Reference"
                                 SelectionChanged="PinsList_SelectionChanged"/>
                        <TextBlock Text="Ranking (ties allowed)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <StackPanel x:Name="RankingPanel"/>
                        <TextBox x:Name="RationaleBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                 VerticalScrollBarVisibility="Auto" Margin="0,6,0,4"
                                 ToolTip="Ranking rationale"/>
                        <TextBlock Text="Apply report" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <TextBlock x:Name="ReportText" Text="Choose a base and add 2–4 patches."
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
        <Border DockPanel.Dock="Bottom" Background="#18263B" Padding="6">
            <TextBlock x:Name="StatusText" Text="Ready — nothing leaves this computer."/>
        </Border>
    </DockPanel>
</Window>
